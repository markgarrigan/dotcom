{
  "name": "markgarrigan-dotcom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs && tailwindcss -i src/site.css -o site/assets/css/site.css --minify",
    "dev": "node src/build.mjs && tailwindcss -i src/site.css -o site/assets/css/site.css --watch",
    "serve": "npx --yes serve site -l 4321"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
